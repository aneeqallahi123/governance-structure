# Groq API key (https://console.groq.com/keys) — required for chat.
GROQ_API_KEY=

# Optional overrides.
# Main tool-calling chat model.
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
# Model used internally for the web_search tool (Groq's compound system,
# which runs server-side web search + browsing on Groq's infrastructure).
GROQ_SEARCH_MODEL=groq/compound-mini

# Where the editable structure JSON is persisted. On Railway this should
# point at a mounted volume, e.g. /data/structure.json, so edits made via
# chat survive redeploys.
STRUCTURE_DATA_PATH=./server/data/structure.json

PORT=3000
